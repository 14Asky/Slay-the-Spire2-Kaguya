  "findings": [
    {
      "area": "第四幕地图同步",
      "status": "已修复",
      "modFile": "Others/Act4MapPatch.cs",
      "cause": "0.113 的 RunManager.GenerateMap 已调用 BeforeMapGenerated；原补丁在 SetActInternal 返回 Task 后再次调用，导致一次生成地图递增两次并清理投票。",
      "change": "删除该重复同步补丁，使用原生生成地图流程。",
      "before": {
        "mapGenerations": 2
      },
      "after": {
        "mapGenerations": 1
      },
      "network": "两个实际 ENet 进程通过原生投票进入第四幕房间，坐标、计数和 Boss 一致。"
    },
    {
      "area": "结局备用分支",
      "status": "已修复",
      "modFile": "Others/Act4MapPatch.cs",
      "cause": "已经进入结局事件后再次执行 EnterNextAct 的分支，仅调用 OnEnded 和杀死角色，没有传递结果打开结算；0.113 Kill 看到 HasRunEnded 后也不会自动打开结算。",
      "change": "使用原生 RunManager.WinRun，统一保存结果、结束角色和打开结算。缺失结局事件的备用分支也使用同一入口。",
      "before": {
        "runEnded": true,
        "gameOverVisible": false
      },
      "after": {
        "runEnded": true,
        "gameOverVisible": true
      },
      "coverage": "正常结局按钮与已进入结局事件的备用结束分支均通过。"
    },
    {
      "area": "当前模组清单目录",
      "status": "已修复",
      "modFile": "Others/UpdateChecker.cs",
      "cause": "备用版本读取在 ModManifest 上反射 path/directory；0.113 的实际目录字段是 Mod.path，清单上没有这些字段。",
      "change": "从匹配到的 Mod 实例读取 path，优先定位实际加载副本。",
      "before": {
        "resolvedManifest": null
      },
      "after": {
        "resolvedManifest": "实际加载的 Mod.path/Kaguya.json"
      },
      "impact": "此前正常的 manifest.version 读取仍然有效，问题影响备用文件查找。"
    }
  ],
