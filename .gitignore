build/

# Godot-generated UID files for C# scripts
*.uid

# Godot import cache
.import/

# Export credentials (sensitive)
export_credentials.cfg

# OS generated files
.DS_Store
Thumbs.db
*.tmp

# IDE / Editor
.vs/
.vscode/
*.user
*.suo
*.DotSettings.user

# Temporary / scratch files
_*
/.tmp_docs.html
/docx_render/
/chinese_docx_render/

# Personal documents unrelated to this mod
/English Class Reflection Summary.docx
/英语课堂总结 中文版.docx

# Debug audio files (not for distribution)
# 目录整体忽略；下面三首是主菜单 BGM，必须入库，否则换机器/重装会丢失
debug_audio/*
!debug_audio/Remember.ogg
!debug_audio/LoveMyself.ogg
!debug_audio/HappySyn.ogg
!debug_audio/Remember.ogg.import
!debug_audio/LoveMyself.ogg.import
!debug_audio/HappySyn.ogg.import

# NuGet packages
*.nupkg
